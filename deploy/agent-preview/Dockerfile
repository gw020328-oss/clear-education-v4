FROM node:24.21.0-bookworm-slim
WORKDIR /app
# Build context must be the allowlisted staging directory generated by package.mjs.
COPY build-manifest.json package.json package-lock.json /app/
COPY src /app/src
COPY specs /app/specs
COPY packages/clear-core /app/packages/clear-core
COPY deploy/agent-preview /app/deploy/agent-preview
RUN npm ci --ignore-scripts --no-audit --no-fund && npm cache clean --force
USER node
ENV NODE_ENV=production
CMD ["node", "deploy/agent-preview/server.mjs"]
