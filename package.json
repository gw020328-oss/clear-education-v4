{
  "name": "clear-education-v4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:init": "node tools/dev.mjs init",
    "dev:start": "node tools/dev.mjs start",
    "dev:status": "node tools/dev.mjs status",
    "dev:unlock": "node tools/dev.mjs unlock",
    "test:dev": "node --test tests/dev/*.test.mjs",
    "test:policy": "node --test tests/policy/*.test.mjs",
    "test:applications": "node --test tests/application/*.test.mjs",
    "test:vault": "node --test tests/vault/*.test.mjs",
    "verify:workspace": "node tools/verify-workspace.mjs",
    "verify:dependencies": "node tools/verify-dependencies.mjs",
    "prepare:workspace": "node tools/prepare-workspace.mjs",
    "verify:workspace:local": "node tools/verify-workspace.mjs --local",
    "test:proof-sessions": "node --test tests/proof-sessions/*.test.mjs",
    "test:exam-evidence": "node --test tests/exam-evidence/*.test.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "ganache": "7.9.2",
    "solc": "0.8.30"
  },
  "version": "0.0.0",
  "description": "CLEAR v4 isolated development workspace — W01 setup only",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
