{{!
    @template local_clearbridge/course_refund

    Course refund policy and integration availability. All strings are plain text.
    Example context (json):
    {"student": true, "conditions": [{"name": "Lecture completion", "source": "Moodle activity"}]}
}}
<div data-clear-workflow>
{{#showconnection}}
<section aria-labelledby="clearbridge-connection-heading" class="card mb-3">
    <div class="card-body">
        {{#student}}
        <h2 id="clearbridge-connection-heading">{{#str}} googleconnectionheading, local_clearbridge {{/str}}</h2>
        {{/student}}
        {{^student}}
        <h2 id="clearbridge-connection-heading">{{#str}} walletconnectionheading, local_clearbridge {{/str}}</h2>
        {{/student}}
        <p data-native-panel-status role="status">{{#str}} nativepanelunknown, local_clearbridge {{/str}}</p>
        {{> local_clearbridge/course_native_connection }}
    </div>
</section>
<section aria-labelledby="clearbridge-application-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-application-heading">{{#str}} nativeapplicationheading, local_clearbridge {{/str}}</h2>
        <p data-workflow-status role="status">{{#str}} nativeworkflowunavailable, local_clearbridge {{/str}}</p>
        <button type="button" class="btn btn-secondary" data-workflow-action="read-session" disabled>
            {{#str}} nativeworkflowreadsession, local_clearbridge {{/str}}
        </button>
        <button type="button" class="btn btn-secondary" data-workflow-action="read-operation" disabled>
            {{#str}} nativeworkflowreadoperation, local_clearbridge {{/str}}
        </button>
        <pre class="mt-3 text-wrap" hidden data-workflow-details="session operation registration" tabindex="0"></pre>
        <div hidden>
            <span data-workflow-message="panelconnected">{{#str}} nativeconnectioncompleted, local_clearbridge {{/str}}</span>
            <span data-workflow-message="activityreview">{{#str}} nativepanelactivityreview, local_clearbridge {{/str}}</span>
            <span data-workflow-message="activityqueued">{{#str}} nativepanelactivityqueued, local_clearbridge {{/str}}</span>
            <span data-workflow-message="activityrecorded">{{#str}} nativepanelactivityrecorded, local_clearbridge {{/str}}</span>
            <span data-workflow-message="activitylimited">{{#str}} nativepanelactivitylimited, local_clearbridge {{/str}}</span>
            <span data-workflow-message="activityunavailable">{{#str}} nativepanelactivityunavailable, local_clearbridge {{/str}}</span>
            <span data-workflow-message="activityconfirmed">{{#str}} nativepanelactivityconfirmed, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificateready_to_start">{{#str}} nativecertificatereadytostart, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificatenot_ready">{{#str}} nativecertificatenotready, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificatestart_accepted">{{#str}} nativecertificatestartacceptedstate, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificatestartaccepted">{{#str}} nativecertificatestartaccepted, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificateawaiting_signature">{{#str}} nativecertificateawaitingsignature, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificatesignature_accepted">{{#str}} nativecertificatesignatureaccepted, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificateverified">{{#str}} nativecertificateverified, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificateunavailable">{{#str}} nativecertificateunavailable, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificatenote">{{#str}} nativecertificatenote, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificatestart-certificate">{{#str}} nativecertificatestart, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificateread-source-signature">{{#str}} nativecertificateread, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificateapprove-source-signature">{{#str}} nativecertificatesign, local_clearbridge {{/str}}</span>
            <span data-workflow-message="certificatewait">{{#str}} nativecertificatewait, local_clearbridge {{/str}}</span>
            <span data-workflow-message="CERTIFICATE_START_ACCEPTED">{{#str}} nativecertificatestartreceipt, local_clearbridge {{/str}}</span>
            <span data-workflow-message="panelunknown">{{#str}} nativepanelunknown, local_clearbridge {{/str}}</span>
            <span data-workflow-message="unavailable">{{#str}} nativeworkflowunavailable, local_clearbridge {{/str}}</span>
            <span data-workflow-message="ready">{{#str}} nativeworkflowready, local_clearbridge {{/str}}</span>
            <span data-workflow-message="busy">{{#str}} nativeworkflowbusy, local_clearbridge {{/str}}</span>
            <span data-workflow-message="success">{{#str}} nativeworkflowsuccess, local_clearbridge {{/str}}</span>
            <span data-workflow-message="failure">{{#str}} nativeworkflowfailure, local_clearbridge {{/str}}</span>
            <span data-workflow-message="unknown">{{#str}} nativeworkflowunknown, local_clearbridge {{/str}}</span>
            <span data-workflow-message="received">{{#str}} nativeworkflowreceived, local_clearbridge {{/str}}</span>
            <span data-workflow-message="unconfirmed">{{#str}} nativeworkflowunconfirmed, local_clearbridge {{/str}}</span>
            <span data-workflow-message="applicationpending">{{#str}} nativeworkflowapplicationpending, local_clearbridge {{/str}}</span>
            <span data-workflow-message="decision">{{#str}} nativedecisionheading, local_clearbridge {{/str}}</span>
            <span data-workflow-message="activity-complete">{{#str}} conditionlecture, local_clearbridge {{/str}}</span>
            <span data-workflow-message="assignment-submitted">{{#str}} conditionassignment, local_clearbridge {{/str}}</span>
            <span data-workflow-message="reflection-topics">{{#str}} conditionreflection, local_clearbridge {{/str}}</span>
            <span data-workflow-message="python-basic-certificate">{{#str}} conditioncertificate, local_clearbridge {{/str}}</span>
            <span data-workflow-message="applicationknown">{{#str}} nativeworkflowdisplayapplicationknown, local_clearbridge {{/str}}</span>
            <span data-workflow-message="applicationreviewed">{{#str}} nativeworkflowdisplayapplicationreviewed, local_clearbridge {{/str}}</span>
            <span data-workflow-message="sourcebound">{{#str}} nativeworkflowdisplaysourcebound, local_clearbridge {{/str}}</span>
            <span data-workflow-message="sourcenotbound">{{#str}} nativeworkflowdisplaysourcenotbound, local_clearbridge {{/str}}</span>
            <span data-workflow-message="operationsaved">{{#str}} nativeworkflowdisplayoperationsaved, local_clearbridge {{/str}}</span>
            <span data-workflow-message="operationprevious">{{#str}} nativeworkflowdisplayoperationprevious, local_clearbridge {{/str}}</span>
            <span data-workflow-message="basis">{{#str}} nativeworkflowdisplaybasis, local_clearbridge {{/str}}</span>
            <span data-workflow-message="original">{{#str}} nativeworkflowdisplayoriginal, local_clearbridge {{/str}}</span>
            <span data-workflow-message="decisiontarget">{{#str}} nativeworkflowdisplaydecisiontarget, local_clearbridge {{/str}}</span>
            <span data-workflow-message="revision">{{#str}} nativeworkflowdisplayrevision, local_clearbridge {{/str}}</span>
            <span data-workflow-message="fingerprint">{{#str}} nativeworkflowdisplayfingerprint, local_clearbridge {{/str}}</span>
            <span data-workflow-message="amount">{{#str}} nativeworkflowdisplayamount, local_clearbridge {{/str}}</span>
            <span data-workflow-message="participantconsent">{{#str}} nativeworkflowdisplayparticipantconsent, local_clearbridge {{/str}}</span>
            <span data-workflow-message="operatorconsent">{{#str}} nativeworkflowdisplayoperatorconsent, local_clearbridge {{/str}}</span>
            <span data-workflow-message="evidencelimits">{{#str}} nativeworkflowdisplayevidencelimits, local_clearbridge {{/str}}</span>
            <span data-workflow-message="publicregistration">{{#str}} nativeworkflowdisplaypublicregistration, local_clearbridge {{/str}}</span>
            <span data-workflow-message="registrationtarget">{{#str}} nativeworkflowdisplayregistrationtarget, local_clearbridge {{/str}}</span>
            <span data-workflow-message="registrationpayload">{{#str}} nativeworkflowdisplayregistrationpayload, local_clearbridge {{/str}}</span>
            <span data-workflow-message="sourcereview">{{#str}} nativeworkflowdisplaysourcereview, local_clearbridge {{/str}}</span>
            <span data-workflow-message="expiry">{{#str}} nativeworkflowdisplayexpiry, local_clearbridge {{/str}}</span>
            <span data-workflow-message="airecorded">{{#str}} nativeworkflowdisplayairecorded, local_clearbridge {{/str}}</span>
            <span data-workflow-message="aieligible">{{#str}} nativeworkflowdisplayaieligible, local_clearbridge {{/str}}</span>
            <span data-workflow-message="aiineligible">{{#str}} nativeworkflowdisplayaiineligible, local_clearbridge {{/str}}</span>
            <span data-workflow-message="aicostnotice">{{#str}} nativeworkflowdisplayaicostnotice, local_clearbridge {{/str}}</span>
            <span data-workflow-message="input">{{#str}} nativeworkflowdisplayinput, local_clearbridge {{/str}}</span>
            <span data-workflow-message="model">{{#str}} nativeworkflowdisplaymodel, local_clearbridge {{/str}}</span>
            <span data-workflow-message="estimatedcost">{{#str}} nativeworkflowdisplayestimatedcost, local_clearbridge {{/str}}</span>
            <span data-workflow-message="costack">{{#str}} nativeworkflowdisplaycostack, local_clearbridge {{/str}}</span>
            <span data-workflow-message="reviewdetails">{{#str}} nativeworkflowdisplayreviewdetails, local_clearbridge {{/str}}</span>
            <span data-workflow-message="receiptincluded">{{#str}} nativeworkflowdisplayreceiptincluded, local_clearbridge {{/str}}</span>
            <span data-workflow-message="receiptnotobserved">{{#str}} nativeworkflowdisplayreceiptnotobserved, local_clearbridge {{/str}}</span>
            <span data-workflow-message="receiptunavailable">{{#str}} nativeworkflowdisplayreceiptunavailable, local_clearbridge {{/str}}</span>
            <span data-workflow-message="finalized">{{#str}} nativeworkflowdisplayfinalized, local_clearbridge {{/str}}</span>
            <span data-workflow-message="notfinalized">{{#str}} nativeworkflowdisplaynotfinalized, local_clearbridge {{/str}}</span>
            <span data-workflow-message="MET">{{#str}} nativeworkflowdisplaymet, local_clearbridge {{/str}}</span>
            <span data-workflow-message="NOT_MET">{{#str}} nativeworkflowdisplaynotmet, local_clearbridge {{/str}}</span>
            <span data-workflow-message="NEEDS_SUPPLEMENT">{{#str}} nativeworkflowdisplayneedssupplement, local_clearbridge {{/str}}</span>
            <span data-workflow-message="MISSING">{{#str}} nativeworkflowdisplaymissing, local_clearbridge {{/str}}</span>
            <span data-workflow-message="UNKNOWN">{{#str}} nativeworkflowdisplayunknown, local_clearbridge {{/str}}</span>
            <span data-workflow-message="CURRENT">{{#str}} nativeworkflowdisplaycurrent, local_clearbridge {{/str}}</span>
            <span data-workflow-message="AVAILABLE">{{#str}} nativeworkflowdisplayavailable, local_clearbridge {{/str}}</span>
            <span data-workflow-message="UNAVAILABLE">{{#str}} nativeworkflowdisplayunavailable, local_clearbridge {{/str}}</span>
            <span data-workflow-message="DELETED">{{#str}} nativeworkflowdisplaydeleted, local_clearbridge {{/str}}</span>
            <span data-workflow-message="EXPIRED">{{#str}} nativeworkflowdisplayexpired, local_clearbridge {{/str}}</span>
            <span data-workflow-message="SUPERSEDED">{{#str}} nativeworkflowdisplaysuperseded, local_clearbridge {{/str}}</span>
            <span data-workflow-message="INVALIDATED">{{#str}} nativeworkflowdisplayinvalidated, local_clearbridge {{/str}}</span>
            <span data-workflow-message="APPLICATION_INACTIVE">{{#str}} nativeworkflowdisplayapplicationinactive, local_clearbridge {{/str}}</span>
            <span data-workflow-message="VALID_AS_RECORDED">{{#str}} nativeworkflowdisplayvalidasrecorded, local_clearbridge {{/str}}</span>
            <span data-workflow-message="AGREE">{{#str}} nativeworkflowdisplayagree, local_clearbridge {{/str}}</span>
            <span data-workflow-message="AWAITING_SIGNATURE">{{#str}} nativeworkflowdisplayawaitingsignature, local_clearbridge {{/str}}</span>
            <span data-workflow-message="STALE">{{#str}} nativeworkflowdisplaystale, local_clearbridge {{/str}}</span>
            <span data-workflow-message="SIGNED">{{#str}} nativeworkflowdisplaysigned, local_clearbridge {{/str}}</span>
            <span data-workflow-message="NOT_READY">{{#str}} nativeworkflowdisplaynotready, local_clearbridge {{/str}}</span>
            <span data-workflow-message="AUTHENTICATED_SOURCE_SESSION_BOUND">{{#str}} nativeworkflowdisplayauthenticatedsourcesessionbound, local_clearbridge {{/str}}</span>
            <span data-workflow-message="PARTICIPANT_SIGNATURE_ACCEPTED">{{#str}} nativeworkflowdisplayparticipantsignatureaccepted, local_clearbridge {{/str}}</span>
        </div>
        {{#student}}
        <p>{{#str}} moodleenrolled, local_clearbridge {{/str}}</p>
        <p id="clearbridge-application-status" role="status">{{#str}} nativeworkflowapplicationpending, local_clearbridge {{/str}}</p>
        <button type="button" class="btn btn-primary" data-workflow-action="create-application"
                aria-describedby="clearbridge-application-status" disabled>
            {{#str}} nativeworkflowcreate, local_clearbridge {{/str}}
        </button>
        <button type="button" class="btn btn-secondary mb-2" data-workflow-action="read-registration" disabled>
            {{#str}} nativeworkflowreadregistration, local_clearbridge {{/str}}
        </button>
        <p id="clearbridge-registration-status" class="mt-3" role="status">{{#str}} nativeworkflowregistrationpending, local_clearbridge {{/str}}</p>
        <button type="button" class="btn btn-secondary" data-workflow-action="approve-registration"
                aria-describedby="clearbridge-registration-status" disabled>
            {{#str}} nativeworkflowregistration, local_clearbridge {{/str}}
        </button>
        {{/student}}
        {{^student}}
        <p class="mb-0">{{#str}} nativeworkflowoperatorread, local_clearbridge {{/str}}</p>
        {{/student}}
    </div>
</section>
{{/showconnection}}
<section aria-labelledby="clearbridge-policy-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-policy-heading">{{#str}} policyheading, local_clearbridge {{/str}}</h2>
        <p>{{#str}} policyamount, local_clearbridge {{/str}}</p>
        {{#fixedscope}}
        <p class="alert alert-info">{{#str}} fixedscopesupport, local_clearbridge {{/str}}</p>
        {{^hasrecords}}<p class="alert alert-warning">{{#str}} fixedscopereconnect, local_clearbridge {{/str}}</p>{{/hasrecords}}
        {{/fixedscope}}
        {{#showconnection}}
        {{#student}}
        <p data-native-activity-status role="status"></p>
        <div data-native-condition-cards></div>
        <button type="button" class="btn btn-secondary mb-2" data-workflow-action="bind-source-session" disabled>
            {{#str}} nativeworkflowbindsource, local_clearbridge {{/str}}
        </button>
        <button type="button" class="btn btn-secondary mb-2" data-workflow-action="read-source-signature" disabled>
            {{#str}} nativeworkflowreadsource, local_clearbridge {{/str}}
        </button>
        <button type="button" class="btn btn-secondary mb-2" data-workflow-action="approve-source-signature" disabled>
            {{#str}} nativeworkflowapprovesource, local_clearbridge {{/str}}
        </button>
        {{/student}}
        <pre class="mt-3 text-wrap" hidden data-workflow-details="source reflection" tabindex="0"></pre>
        <p id="clearbridge-reflection-status" role="status">{{#str}} nativeworkflowreflectionpending, local_clearbridge {{/str}}</p>
        <label class="d-block mb-2">
            <input type="checkbox" data-workflow-ack disabled>
            {{#str}} nativeworkflowack, local_clearbridge {{/str}}
        </label>
        <button type="button" class="btn btn-secondary mb-3" data-workflow-action="approve-reflection"
                aria-describedby="clearbridge-reflection-status" disabled>
            {{#str}} nativeworkflowreflection, local_clearbridge {{/str}}
        </button>
        {{/showconnection}}
        {{#synthetic}}
        <p class="alert alert-info">{{#str}} syntheticprojection, local_clearbridge {{/str}}</p>
        {{/synthetic}}
        <dl class="row mb-0">
            {{#conditions}}
            <dt class="col-sm-5">{{name}}</dt>
            <dd class="col-sm-7">
                {{source}}
                {{#record}}
                <p class="mb-1">{{status}}</p>
                <p class="mb-1">{{connection}}</p>
                {{#provenance}}<p class="mb-1">{{.}}</p>{{/provenance}}
                {{#topics}}
                <p class="mb-1">{{topic}}: {{outcome}}</p>
                {{/topics}}
                {{/record}}
                {{^record}}<p class="mb-1">{{#str}} nativeevidenceunavailable, local_clearbridge {{/str}}</p>{{/record}}
            </dd>
            {{/conditions}}
        </dl>
        {{#hasrecords}}
        <p class="mb-0">{{#str}} currentnessunknown, local_clearbridge {{/str}}</p>
        {{/hasrecords}}
        {{^hasrecords}}
        <p class="mb-0">{{#str}} conditionstatusunavailable, local_clearbridge {{/str}}</p>
        {{/hasrecords}}
    </div>
</section>
<section aria-labelledby="clearbridge-decision-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-decision-heading">{{#str}} nativedecisionheading, local_clearbridge {{/str}}</h2>
        {{#showconnection}}
        <pre class="mt-3 text-wrap" hidden data-workflow-details="application evidence" tabindex="0"></pre>
        <button type="button" class="btn btn-secondary mb-2" data-workflow-action="read-application" disabled>
            {{#str}} nativeworkflowreadapplication, local_clearbridge {{/str}}
        </button>
        <button type="button" class="btn btn-secondary mb-2" data-workflow-action="decision-evidence" disabled>
            {{#str}} nativeworkflowreadevidence, local_clearbridge {{/str}}
        </button>
        {{/showconnection}}
        {{#payment}}
        <p class="mb-0">{{decisionstatus}}</p>
        {{/payment}}
        {{^payment}}
        <p class="mb-0">{{#str}} nativedecisionunavailable, local_clearbridge {{/str}}</p>
        {{/payment}}
    </div>
</section>
<section aria-labelledby="clearbridge-consent-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-consent-heading">{{#str}} nativeconsentheading, local_clearbridge {{/str}}</h2>
        <dl class="row mb-0">
            <dt class="col-sm-5">{{#str}} consentstudent, local_clearbridge {{/str}}</dt>
            <dd class="col-sm-7">{{#payment}}{{participant}}{{/payment}}{{^payment}}{{#str}} nativeconsentunknown, local_clearbridge {{/str}}{{/payment}}</dd>
            <dt class="col-sm-5">{{#str}} consentteacher, local_clearbridge {{/str}}</dt>
            <dd class="col-sm-7">{{#payment}}{{operator}}{{/payment}}{{^payment}}{{#str}} nativeconsentunknown, local_clearbridge {{/str}}{{/payment}}</dd>
        </dl>
        {{#showconnection}}
        <p id="clearbridge-consent-status" role="status">
            {{#str}} nativeworkflowreviewconsent, local_clearbridge {{/str}}
        </p>
        <button type="button" class="btn btn-secondary" data-workflow-action="consent" data-workflow-choice="AGREE"
                aria-describedby="clearbridge-consent-status" disabled>
            {{#str}} nativeworkflowagree, local_clearbridge {{/str}}
        </button>
        <button type="button" class="btn btn-secondary" data-workflow-action="consent" data-workflow-choice="WITHDRAW"
                aria-describedby="clearbridge-consent-status" disabled>
            {{#str}} nativeworkflowwithdraw, local_clearbridge {{/str}}
        </button>
        {{/showconnection}}
    </div>
</section>
<section aria-labelledby="clearbridge-receipt-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-receipt-heading">{{#str}} nativereceiptheading, local_clearbridge {{/str}}</h2>
        {{#showconnection}}
        <pre class="mt-3 text-wrap" hidden data-workflow-details="receipt" tabindex="0"></pre>
        <button type="button" class="btn btn-secondary mb-2" data-workflow-action="payment-receipt" disabled>
            {{#str}} nativeworkflowreadreceipt, local_clearbridge {{/str}}
        </button>
        {{/showconnection}}
        {{#payment}}
        <p class="mb-0">{{receiptstatus}}</p>
        {{/payment}}
        {{^payment}}
        <p class="mb-0">{{#str}} receiptunavailable, local_clearbridge {{/str}}</p>
        {{/payment}}
    </div>
</section>
</div>
