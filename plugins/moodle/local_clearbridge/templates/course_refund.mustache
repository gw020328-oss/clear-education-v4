{{!
    @template local_clearbridge/course_refund

    Course refund policy and integration availability. All strings are plain text.
    Example context (json):
    {"student": true, "conditions": [{"name": "Lecture completion", "source": "Moodle activity"}]}
}}
{{#showconnection}}
<section aria-labelledby="clearbridge-connection-heading" class="card mb-3">
    <div class="card-body">
        {{#student}}
        <h2 id="clearbridge-connection-heading">{{#str}} googleconnectionheading, local_clearbridge {{/str}}</h2>
        {{/student}}
        {{^student}}
        <h2 id="clearbridge-connection-heading">{{#str}} walletconnectionheading, local_clearbridge {{/str}}</h2>
        {{/student}}
        {{#connectionenabled}}
        {{> local_clearbridge/course_login }}
        {{/connectionenabled}}
        {{^connectionenabled}}
        <p class="mb-0">{{#str}} connectionstatusunavailable, local_clearbridge {{/str}}</p>
        {{/connectionenabled}}
    </div>
</section>
{{/showconnection}}
<section aria-labelledby="clearbridge-policy-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-policy-heading">{{#str}} policyheading, local_clearbridge {{/str}}</h2>
        <p>{{#str}} policyamount, local_clearbridge {{/str}}</p>
        {{#fixedscope}}
        <p class="alert alert-info">{{#str}} fixedscopesupport, local_clearbridge {{/str}}</p>
        {{^hasrecords}}<p class="alert alert-warning">{{#str}} fixedscopereconnect, local_clearbridge {{/str}}</p>{{/hasrecords}}
        {{/fixedscope}}
        {{#synthetic}}
        <p class="alert alert-info">{{#str}} syntheticprojection, local_clearbridge {{/str}}</p>
        {{/synthetic}}
        {{#student}}
        <p>{{#str}} moodleenrolled, local_clearbridge {{/str}}</p>
        <p>{{#str}} clearregistrationunavailable, local_clearbridge {{/str}}</p>
        {{/student}}
        <dl class="row mb-0">
            {{#conditions}}
            <dt class="col-sm-5">{{name}}</dt>
            <dd class="col-sm-7">
                {{source}}
                {{#record}}
                <p class="mb-1">{{status}}</p>
                <p class="mb-1">{{connection}}</p>
                {{#provenance}}<p class="mb-1">{{.}}</p>{{/provenance}}
                {{#topics}}
                <p class="mb-1">{{topic}}: {{outcome}}</p>
                {{/topics}}
                {{/record}}
            </dd>
            {{/conditions}}
        </dl>
        {{#hasrecords}}
        <p class="mb-0">{{#str}} currentnessunknown, local_clearbridge {{/str}}</p>
        {{/hasrecords}}
        {{^hasrecords}}
        <p class="mb-0">{{#str}} conditionstatusunavailable, local_clearbridge {{/str}}</p>
        {{/hasrecords}}
    </div>
</section>
{{#student}}
<section aria-labelledby="clearbridge-decision-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-decision-heading">{{#str}} decisionheading, local_clearbridge {{/str}}</h2>
        <p>{{#str}} decisionunavailable, local_clearbridge {{/str}}</p>
        {{^payment}}
        <p class="mb-0">{{#str}} receiptunavailable, local_clearbridge {{/str}}</p>
        {{/payment}}
    </div>
</section>
{{/student}}
{{#payment}}
<section aria-labelledby="clearbridge-recorded-payment-heading" class="card mb-3">
    <div class="card-body">
        <h2 id="clearbridge-recorded-payment-heading">{{#str}} recordedpaymentheading, local_clearbridge {{/str}}</h2>
        <dl class="row mb-0">
            <dt class="col-sm-5">{{#str}} consentstudent, local_clearbridge {{/str}}</dt>
            <dd class="col-sm-7">{{participant}}</dd>
            <dt class="col-sm-5">{{#str}} consentteacher, local_clearbridge {{/str}}</dt>
            <dd class="col-sm-7">{{operator}}</dd>
        </dl>
        <p class="mb-0">{{receiptstatus}}</p>
    </div>
</section>
{{/payment}}
